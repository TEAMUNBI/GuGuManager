{
  "name": "@gugumanager/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api:check": "openapi-typescript ../api/openapi/openapi.yaml -o src/lib/openapi.generated.ts --check",
    "api:generate": "openapi-typescript ../api/openapi/openapi.yaml -o src/lib/openapi.generated.ts",
    "api:lint": "redocly lint ../api/openapi/openapi.yaml --extends minimal --format stylish",
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "pree2e": "npm run build",
    "e2e": "playwright test --project=chromium",
    "pree2e:ui": "npm run build",
    "e2e:ui": "playwright test --project=chromium --ui",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
