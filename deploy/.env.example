# ===== 开发模式（deploy/docker-compose.yml）=====
GUGU_HTTP_PORT=8080
# Agent mTLS gRPC 端口（仅 GUGU_ENVIRONMENT=production 时实际监听）
GUGU_AGENT_GRPC_PORT=8443
GUGU_DEV_ADMIN_EMAIL=admin@gugu.local
GUGU_DEV_ADMIN_PASSWORD=gugu-dev-2026
GUGU_DEV_AGENT_TOKEN=gugu-agent-dev-token
# agent 服务的节点名称
GUGU_AGENT_NODE_NAME=dev-node-01
POSTGRES_DB=gugumanager
POSTGRES_USER=gugumanager
POSTGRES_PASSWORD=gugumanager-dev-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# ===== 生产模式（deploy/docker-compose.prod.yml）=====
# 面板对外公开的 HTTPS 地址（反向代理在此终止 TLS）
GUGU_PUBLIC_URL=https://panel.example.com
# 兼容用长期静态注册令牌：Control Plane 接受该值，Agent 在没有一次性令牌时也使用该值。
# 日常接入建议保持为空，通过 Web 节点页签发一次性令牌。
GUGU_AGENT_REGISTRATION_TOKEN=
# Agent 本次注册使用的一次性令牌；只注入 Agent，不注入 Control Plane，注册成功后清空。
GUGU_AGENT_ENROLLMENT_TOKEN=
# 可选 CA SHA-256 指纹钉扎（叶证书或 CA 根，允许冒号分隔）；不能替代预置 agent-ca.crt。
GUGU_AGENT_CA_FINGERPRINT=
# Agent HTTP 心跳令牌：留空时与 bootstrap token 一致
GUGU_AGENT_TOKEN=
# 面板位于 NAT/端口转发后时补充公网 IP（证书 SAN），逗号分隔
GUGU_AGENT_GRPC_PUBLIC_IPS=
# 生产 agent 服务的节点名称
GUGU_AGENT_NODE_NAME=prod-node-01
GUGU_LOG_LEVEL=info
GUGU_LOG_FORMAT=json

# ===== 生产 secret 文件（deploy/secrets/）=====
# 生产模式要求 secret 以文件形式挂载（可读、非空），文件名对应
# docker-compose.prod.yml 的 secrets 段，挂载点为 /run/secrets/<名称>：
#   encryption.key  —— 数据加密密钥（高熵随机字节）
#   agent-ca.crt    —— Agent CA 根证书；Control Plane 使用，Agent 首次注册前也必须预置
#   agent-ca.key    —— Agent CA 私钥，只挂载到 Control Plane，绝不分发给 Agent
#   bootstrap-token —— 初始化 bootstrap 令牌（兼容路径会在未设置静态注册令牌时回退该值）
