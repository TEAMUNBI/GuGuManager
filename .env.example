# ===== Control Plane：开发模式（默认）=====
GUGU_ENVIRONMENT=development
GUGU_HTTP_ADDR=127.0.0.1:8080
GUGU_WEB_ROOT=web/dist
GUGU_DEV_ADMIN_EMAIL=admin@gugu.local
GUGU_DEV_ADMIN_PASSWORD=gugu-dev-2026
GUGU_DEV_AGENT_TOKEN=gugu-agent-dev-token
# Optional: set a 32-256 character value to start without the seeded admin.
# GUGU_DEV_BOOTSTRAP_TOKEN=replace-with-a-high-entropy-development-token
GUGU_DEV_OPERATION_LATENCY=850ms
GUGU_DEV_DATA_ROOT=var/development/servers
GUGU_LOG_LEVEL=info
GUGU_LOG_FORMAT=json

# ===== Control Plane：生产模式（GUGU_ENVIRONMENT=production）=====
# 说明：生产要求 secret 以文件形式挂载（必须是可读的非空文件），
# 且必须显式设置 GUGU_TLS_TERMINATED=true，否则启动校验失败。
# GUGU_ENVIRONMENT=production
# GUGU_HTTP_ADDR=0.0.0.0:8080
# GUGU_WEB_ROOT=web/dist
# 必填：面板对外公开的 HTTPS 地址（反向代理终止 TLS 后转发）
# GUGU_PUBLIC_URL=https://panel.example.com
# 必填：PostgreSQL 连接串
# GUGU_DATABASE_URL=postgres://gugumanager:password@127.0.0.1:5432/gugumanager
# 可选：Redis 连接串（未设置则不启用 Redis）
# GUGU_REDIS_URL=redis://127.0.0.1:6379/0
# 必填：session 签名密钥 / 数据加密密钥 / Agent CA 证书 / Agent CA 私钥
# GUGU_SESSION_KEY_FILE=/etc/gugumanager/secrets/session.key
# GUGU_ENCRYPTION_KEY_FILE=/etc/gugumanager/secrets/encryption.key
# GUGU_AGENT_CA_CERT_FILE=/etc/gugumanager/secrets/agent-ca.crt
# GUGU_AGENT_CA_KEY_FILE=/etc/gugumanager/secrets/agent-ca.key
# 可选：bootstrap 初始化令牌文件（未设置时跳过；Agent 注册令牌缺省时回退该值）
# GUGU_BOOTSTRAP_TOKEN_FILE=/etc/gugumanager/secrets/bootstrap-token
# 必填：生产必须显式声明 TLS 由外部终止
# GUGU_TLS_TERMINATED=true
# Agent mTLS gRPC 监听地址（默认 127.0.0.1:8443；仅生产启动）
# GUGU_AGENT_GRPC_ADDR=0.0.0.0:8443
# 可选：面板位于 NAT/端口转发后时补充公网 IP（证书 SAN），逗号分隔
# GUGU_AGENT_GRPC_PUBLIC_IPS=203.0.113.10
# 可选：Agent 注册令牌（未设置时回退 bootstrap token）
# GUGU_AGENT_REGISTRATION_TOKEN=replace-with-a-high-entropy-registration-token
# 可选：Agent HTTP 心跳令牌（未设置时与 bootstrap token 一致）
# GUGU_AGENT_TOKEN=replace-with-a-high-entropy-agent-token
# 可选：服务器数据根目录（默认 var/production/servers）
# GUGU_FILE_ROOT=var/production/servers
# 可选：migration 目录覆盖（镜像/发布物不含源码 migrations 时必需）
# GUGU_MIGRATIONS_DIR=migrations

# ===== Node Agent（cmd/agent，独立部署在游戏节点）=====
# 说明：优先读取 GUGU_AGENT_* 变量，缺失时回退旧变量（GUGU_PANEL_URL /
# GUGU_REGISTRATION_TOKEN / GUGU_NODE_NAME / GUGU_AGENT_TOKEN）。
# GUGU_AGENT_PANEL_ADDR=panel.example.com:8443
# GUGU_AGENT_REGISTRATION_TOKEN=replace-with-the-same-registration-token
# GUGU_AGENT_NODE_NAME=prod-node-01
# GUGU_AGENT_VERSION=0.1.0-dev
# GUGU_AGENT_DATA_ROOT=var/production/servers
# GUGU_AGENT_CERT_DIR=var/production/agent-certs
# GUGU_AGENT_TRUST_ROOT=var/production/agent-certs/ca.crt
