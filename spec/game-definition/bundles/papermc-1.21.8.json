{
  "gameDefinitionId": "io.gugumanager.papermc",
  "definitionVersion": "1.0.0",
  "gameVersion": "1.21.8",
  "digest": "sha256:a0118b857dacc2ffd27a56bcdd9cdfcd27f699a5d55ca424bffc447b0572fbfa",
  "schemaVersion": "gugumanager.io/games/v1alpha1",
  "license": "Apache-2.0",
  "compatibility": {
    "agent": "\u003e=0.1 \u003c1.0",
    "panel": "\u003e=0.1 \u003c1.0",
    "platforms": "linux/amd64,linux/arm64"
  },
  "capabilities": [
    "console",
    "query",
    "backup",
    "update"
  ],
  "image": "itzg/minecraft-server@sha256:da92e9d215c159cd53a0e960d9a9cb67b5455ba1a7fca5b35d92be1e0bde857a",
  "command": {
    "executable": "/image/scripts/start",
    "args": []
  },
  "adapter": "container/v1",
  "user": "0:0",
  "workingDir": "/data",
  "environment": {
    "EULA": "TRUE",
    "MEMORY": "{{ memory_mb }}M",
    "PAPER_BUILD": "60",
    "TYPE": "PAPER",
    "VERSION": "1.21.8"
  },
  "dataMounts": [
    {
      "name": "server-data",
      "target": "/data",
      "backup": true
    }
  ],
  "console": {
    "adapter": "minecraft-rcon/v1",
    "port": 25575
  },
  "variables": {
    "schema": {
      "type": "object",
      "required": [
        "accept_eula",
        "memory_mb"
      ],
      "properties": {
        "accept_eula": {
          "type": "boolean",
          "default": true,
          "const": true
        },
        "memory_mb": {
          "type": "integer",
          "default": 2048,
          "minimum": 1024,
          "maximum": 32768
        },
        "rcon_password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "secrets": [
      "rcon_password"
    ],
    "bindings": [
      {
        "variable": "memory_mb",
        "target": "environment",
        "name": "MEMORY",
        "template": "{{ value }}M"
      }
    ]
  },
  "stop": {
    "method": "console",
    "value": "stop",
    "timeoutSeconds": 30
  },
  "health": {
    "type": "tcp",
    "portRef": "game",
    "intervalSeconds": 10,
    "timeoutSeconds": 5,
    "failureThreshold": 6
  },
  "ports": [
    {
      "name": "game",
      "protocol": "tcp",
      "containerPort": 25565,
      "role": "primary"
    }
  ],
  "install": {},
  "lifecycle": {
    "install": "builtin.artifacts",
    "configure": "builtin.bindings",
    "update": "builtin.replace-artifacts"
  }
}
