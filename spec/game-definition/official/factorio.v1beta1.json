{
  "apiVersion": "gugumanager.io/games/v1beta1",
  "kind": "GameDefinition",
  "metadata": {
    "id": "io.gugumanager.factorio",
    "license": "Apache-2.0",
    "name": "Factorio",
    "version": "1.0.0"
  },
  "spec": {
    "bundle": {
      "artifacts": []
    },
    "capabilities": [
      "console",
      "query",
      "backup",
      "update"
    ],
    "compatibility": {
      "agent": "\u003e=0.1 \u003c1.0",
      "panel": "\u003e=0.1 \u003c1.0",
      "platforms": [
        "linux/amd64"
      ]
    },
    "install": {},
    "lifecycle": {
      "configure": "builtin.bindings",
      "install": "builtin.artifacts",
      "update": "builtin.replace-artifacts"
    },
    "release": {
      "version": "2.0.55"
    },
    "runtime": {
      "adapter": "container/v1",
      "command": {
        "args": [
          "--start-server",
          "/data/saves/world.zip"
        ],
        "executable": "/opt/factorio/bin/x64/factorio"
      },
      "dataMounts": [
        {
          "backup": true,
          "name": "server-data",
          "target": "/data"
        }
      ],
      "health": {
        "failureThreshold": 4,
        "intervalSeconds": 15,
        "portRef": "game",
        "timeoutSeconds": 5,
        "type": "udp-query"
      },
      "image": "registry.invalid/gugumanager/factorio@sha256:4444444444444444444444444444444444444444444444444444444444444444",
      "ports": [
        {
          "containerPort": 34197,
          "name": "game",
          "protocol": "udp",
          "role": "primary"
        }
      ],
      "stop": {
        "method": "console",
        "timeoutSeconds": 30,
        "value": "/quit"
      },
      "user": "845:845",
      "workingDir": "/opt/factorio"
    },
    "variables": {
      "schema": {
        "properties": {
          "autosave_interval": {
            "default": 10,
            "maximum": 60,
            "minimum": 1,
            "type": "integer"
          },
          "difficulty": {
            "default": "normal",
            "enum": [
              "peaceful",
              "normal",
              "hard"
            ],
            "type": "string"
          },
          "public_listing": {
            "default": false,
            "type": "boolean"
          },
          "server_name": {
            "default": "Friday Factory",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "server_token": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "server_name",
          "autosave_interval"
        ],
        "type": "object"
      },
      "secrets": [
        "server_token"
      ]
    }
  }
}
