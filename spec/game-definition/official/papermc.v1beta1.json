{
  "apiVersion": "gugumanager.io/games/v1beta1",
  "kind": "GameDefinition",
  "metadata": {
    "id": "io.gugumanager.papermc",
    "license": "Apache-2.0",
    "name": "PaperMC",
    "version": "1.0.0"
  },
  "spec": {
    "bundle": {
      "artifacts": []
    },
    "capabilities": [
      "console",
      "query",
      "backup",
      "update"
    ],
    "compatibility": {
      "agent": "\u003e=0.1 \u003c1.0",
      "panel": "\u003e=0.1 \u003c1.0",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    "install": {},
    "lifecycle": {
      "configure": "builtin.bindings",
      "install": "builtin.artifacts",
      "update": "builtin.replace-artifacts"
    },
    "release": {
      "version": "1.21.8"
    },
    "runtime": {
      "adapter": "container/v1",
      "command": {
        "args": [],
        "executable": "/image/scripts/start"
      },
      "console": {
        "adapter": "minecraft-rcon/v1",
        "port": 25575
      },
      "dataMounts": [
        {
          "backup": true,
          "name": "server-data",
          "target": "/data"
        }
      ],
      "environment": {
        "EULA": "TRUE",
        "MEMORY": "{{ memory_mb }}M",
        "PAPER_BUILD": "60",
        "TYPE": "PAPER",
        "VERSION": "1.21.8"
      },
      "health": {
        "failureThreshold": 6,
        "intervalSeconds": 10,
        "portRef": "game",
        "timeoutSeconds": 5,
        "type": "tcp"
      },
      "image": "itzg/minecraft-server@sha256:da92e9d215c159cd53a0e960d9a9cb67b5455ba1a7fca5b35d92be1e0bde857a",
      "ports": [
        {
          "containerPort": 25565,
          "name": "game",
          "protocol": "tcp",
          "role": "primary"
        }
      ],
      "stop": {
        "method": "console",
        "timeoutSeconds": 30,
        "value": "stop"
      },
      "user": "0:0",
      "workingDir": "/data"
    },
    "variables": {
      "bindings": [
        {
          "name": "MEMORY",
          "target": "environment",
          "template": "{{ value }}M",
          "variable": "memory_mb"
        }
      ],
      "schema": {
        "properties": {
          "accept_eula": {
            "const": true,
            "default": true,
            "type": "boolean"
          },
          "memory_mb": {
            "default": 2048,
            "maximum": 32768,
            "minimum": 1024,
            "type": "integer"
          },
          "rcon_password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "accept_eula",
          "memory_mb"
        ],
        "type": "object"
      },
      "secrets": [
        "rcon_password"
      ]
    }
  }
}
