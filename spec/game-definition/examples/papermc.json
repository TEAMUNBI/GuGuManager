{
  "apiVersion": "gugumanager.io/games/v1alpha1",
  "kind": "GameDefinition",
  "metadata": {
    "id": "io.gugumanager.papermc",
    "name": "PaperMC",
    "version": "1.0.0",
    "license": "Apache-2.0"
  },
  "spec": {
    "release": {
      "version": "1.21.8"
    },
    "compatibility": {
      "panel": ">=0.1 <1.0",
      "agent": ">=0.1 <1.0",
      "platforms": ["linux/amd64", "linux/arm64"]
    },
    "capabilities": ["console", "query", "backup", "update"],
    "variables": {
      "schema": {
        "type": "object",
        "required": ["accept_eula", "memory_mb"],
        "properties": {
          "accept_eula": {"type": "boolean", "default": true, "const": true},
          "memory_mb": {"type": "integer", "default": 2048, "minimum": 1024, "maximum": 32768},
          "rcon_password": {"type": "string", "minLength": 8, "maxLength": 128}
        }
      },
      "secrets": ["rcon_password"],
      "bindings": [
        {"variable": "memory_mb", "target": "environment", "name": "MEMORY", "template": "{{ value }}M"}
      ]
    },
    "runtime": {
      "adapter": "container/v1",
      "image": "itzg/minecraft-server@sha256:da92e9d215c159cd53a0e960d9a9cb67b5455ba1a7fca5b35d92be1e0bde857a",
      "user": "0:0",
      "workingDir": "/data",
      "command": {"executable": "/image/scripts/start", "args": []},
      "environment": {
        "TYPE": "PAPER",
        "VERSION": "1.21.8",
        "PAPER_BUILD": "60",
        "EULA": "TRUE",
        "MEMORY": "{{ memory_mb }}M"
      },
      "dataMounts": [{"name": "server-data", "target": "/data", "backup": true}],
      "ports": [{"name": "game", "protocol": "tcp", "containerPort": 25565, "role": "primary"}],
      "stop": {"method": "console", "value": "stop", "timeoutSeconds": 30},
      "health": {"type": "tcp", "portRef": "game", "intervalSeconds": 10, "timeoutSeconds": 5, "failureThreshold": 6},
      "console": {"adapter": "minecraft-rcon/v1", "port": 25575}
    },
    "install": {},
    "lifecycle": {"install": "builtin.artifacts", "configure": "builtin.bindings", "update": "builtin.replace-artifacts"}
  }
}
